# ============================================================
# NutriBot Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# ─── Required ───────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Optional (for accurate nutrition data) ─────────────────
# Get free credentials at: https://developer.nutritionix.com/
# If not set, the app uses estimated mock nutrition data
NUTRITIONIX_APP_ID=your_nutritionix_app_id_here
NUTRITIONIX_API_KEY=your_nutritionix_api_key_here
